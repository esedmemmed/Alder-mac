# Pins for the mpv + FFmpeg stack (macOS 11.0 x86_64). Sourced by mac/deps/build-stack.sh, plain KEY=value.
# Each dep owns the keys prefixed with its upper-case name; `build-stack.sh key <dep>` hashes exactly those lines,
# so edit one dep's pin and only that dep and its dependents rebuild. Every sha256 was checked against a download
# made on Windows (2026-11-01); the libplacebo and LuaJIT pins are git commits.
# Comments never start with a key name, so they stay out of the hashes.

# mpv v0.41.0. GitHub has no release asset for mpv, only the tag archive (its hash can drift if GitHub changes
# its archive compression; a mismatch fails the build loudly).
MPV_VERSION=0.41.0
MPV_URL=https://github.com/mpv-player/mpv/archive/refs/tags/v0.41.0.tar.gz
MPV_SHA256=ee21092a5ee427353392360929dc64645c54479aefdb5babc5cfbb5fad626209

# FFmpeg n8.1.3 (tag exists upstream: 23151b11c7...). The ffmpeg.org tarball instead of the GitHub archive: stable hash.
FFMPEG_VERSION=8.1.3
FFMPEG_URL=https://ffmpeg.org/releases/ffmpeg-8.1.3.tar.xz
FFMPEG_SHA256=7138d28c96d9d3e3af4ee3d8cad72741f8ffb40da90c1112235dea3ecd3178a3

# libplacebo v7.360.1. mpv 0.41.0 needs >=6.338.2; 7.360.1 is the last patch release before 7.387.0 and was not
# chosen for being newest. Cloned with submodules (glad, jinja, markupsafe, fast_float, Vulkan-Headers) because GitHub's
# archive omits them; the commit pins the tag and its submodule commits.
LIBPLACEBO_VERSION=7.360.1
LIBPLACEBO_URL=https://github.com/haasn/libplacebo.git
LIBPLACEBO_TAG=v7.360.1
LIBPLACEBO_COMMIT=cee9b076f2c63104ccfd497fa79c39a867293ec4

# libass 0.17.5 (release tarball with configure).
LIBASS_VERSION=0.17.5
LIBASS_URL=https://github.com/libass/libass/releases/download/0.17.5/libass-0.17.5.tar.xz
LIBASS_SHA256=2dca25c0e0c837ddf00b52011b3f82cac1e4ddd3ad018227806b0c2288864acc

# FreeType 2.14.3, not 2.15.0 (one release older, chosen to stay on a release with a patch behind it).
FREETYPE_VERSION=2.14.3
FREETYPE_URL=https://download.savannah.gnu.org/releases/freetype/freetype-2.14.3.tar.xz
FREETYPE_SHA256=36bc4f1cc413335368ee656c42afca65c5a3987e8768cc28cf11ba775e785a5f

# HarfBuzz 14.6.0, not the 15.0.0 major (new major, unproven with libass 0.17.5).
HARFBUZZ_VERSION=14.6.0
HARFBUZZ_URL=https://github.com/harfbuzz/harfbuzz/releases/download/14.6.0/harfbuzz-14.6.0.tar.xz
HARFBUZZ_SHA256=d07a007327277708a2a73ae437887cdbaf282937f6d03ca5467723e9099af586

FRIBIDI_VERSION=1.0.18
FRIBIDI_URL=https://github.com/fribidi/fribidi/releases/download/v1.0.18/fribidi-1.0.18.tar.xz
FRIBIDI_SHA256=1de5e8073d035388b71d0b2d452b1da1f8caeea8a7702997b401fe1b6250727f

# LuaJIT has no stable tags: pinned to the head of branch v2.1 on 2026-11-01. The GitHub archive carries .relver
# (export-subst), which the Makefile needs for its version when there is no .git.
LUAJIT_VERSION=2.1-ea9eb7e
LUAJIT_URL=https://github.com/LuaJIT/LuaJIT/archive/ea9eb7edb5eac4a9d175d74523db34fac0fa5180.tar.gz
LUAJIT_SHA256=338a5640be00b89fd0a2a027a7433fcbbb4d006be840d216d84151386b5bcdf7

DAV1D_VERSION=1.5.4
DAV1D_URL=https://downloads.videolan.org/pub/videolan/dav1d/1.5.4/dav1d-1.5.4.tar.xz
DAV1D_SHA256=686616b7c69eb88d44459391ab25cac13b6647a3b288835c5784e71c1514a5c5

# nasm 2.16.03, not 3.x: the long-proven release for dav1d and FFmpeg x86 asm. Built from source, installed to the
# tools prefix (never in the stack tarball).
NASM_VERSION=2.16.03
NASM_URL=https://www.nasm.us/pub/nasm/releasebuilds/2.16.03/nasm-2.16.03.tar.xz
NASM_SHA256=1412a1c760bbd05db026b6c0d1657affd6631cd0a63cddb6f73cc6d4aa616148

# meson from pip, installed with --require-hashes (hash of the wheel). mpv 0.41.0 wants meson >=1.3.0.
MESON_VERSION=1.12.1
MESON_WHEEL_SHA256=930bc7542cbd9f57009e182fd014eba48cf1a0180a7b9006d2d32d8f168d8b02
